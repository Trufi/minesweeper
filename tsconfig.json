{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2015",
        "moduleResolution": "node",
        "lib": ["dom", "es2022"],
        "sourceMap": true,
        "strict": true,
        "noEmitHelpers": true,
        "importHelpers": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "react-jsx"
    }
}
